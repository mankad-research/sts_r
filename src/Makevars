# RcppParallel (TBB) for the multithreaded E- and M-steps.
# ARMA_WARN_LEVEL=1 keeps Armadillo from printing non-critical warnings: its
# output stream is R's console, which must not be touched from worker threads.
PKG_CPPFLAGS = -DARMA_WARN_LEVEL=1 -DRCPP_PARALLEL_USE_TBB=1
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(shell "${R_HOME}/bin${R_ARCH_BIN}/Rscript" -e "RcppParallel::RcppParallelLibs()")
